<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 자동 백업/기기 이전 규칙 (API 31+).
  cloud-backup: 구글 드라이브 백업(재설치 복원), device-transfer: 새 기기 이전.
  관심사·설정·즐겨찾기·초대 코드·보너스 사용권을 복원.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="database" path="news_db" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="database" path="news_db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
